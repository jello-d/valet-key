#!/bin/sh
# valet-key -- a profile-aware, concurrent-safe launcher for coding agents.
#
# You run `claude` / `gemini` (per-agent SHIMS that symlink to this engine); the
# engine reads its own invoked name ($0) to pick the agent, resolves which
# PROFILE applies (work / personal / client-a ...), guards coherence, leases an
# isolated credential slot, and execs the real agent. Invoked as `valet-key` it
# is the management CLI.
#
#   claude [args]            run Claude in the resolved profile, on a lease slot
#   valet-key run <agent> [args]    the same, named explicitly
#   valet-key provision <agent> [profile] [N]    create/refresh a pool (N=5)
#   valet-key login [warm|check|force|stale] [agent] [profile]    logins
#   valet-key stale              all pools: warm slots near their cap
#   valet-key check [agent [profile]]    audit a pool, or the whole setup
#   valet-key resolve [agent]    dry run: which profile/pool applies HERE
#   valet-key doctor             environment health (PATH, creds, saturation)
#   valet-key slots <verb> ...   raw slot-pool escape hatch
#
# Shims (how `claude`/`gemini` come to route here -- a dir of symlinks to this
# engine, first on PATH so it shadows the real binary; the pyenv/rbenv pattern):
#   valet-key shim <agent>...    create shim(s) in the shims dir (intercept)
#   valet-key unshim <agent>...  remove shim(s)
#   valet-key shims              list current shims
#   valet-key init               print the PATH line for the shims dir (eval it)
#   valet-key shims-dir          print the shims dir
#   valet-key rehash             re-point existing shims at this engine
#
# SEAMS (optional; default is a single "personal" profile, proceed). A hook's
# DIRECTORY says which question it answers, so there is no verb to dispatch and
# no need to answer one you do not care about:
#   $VALET_KEY_CONFIG/hooks/profile.d/*  -> print a profile name (first that
#                                           ANSWERS wins; non-zero = cannot
#                                           tell, try the next)
#   $VALET_KEY_CONFIG/hooks/guard.d/*    -> 0 ok / 2 warn / 1 refuse (msg).
#                                           EVERY hook runs; any refusal wins
#   $VALET_KEY_CONFIG/profiles  -> "<profile> <matchdir>" cwd-resolver lines
#                                  (consulted only when every hook abstains)
#
# POSIX sh (dash). Non-privileged. An integrator fills the seams; standalone it
# just works, with one profile and no refusals. See man valet-key.
set -eu

# --- self-location: our libexec, from this script's real path ----------------
# $0 may be a bare name (PATH lookup), relative, or absolute, and reaches us
# through the shim symlink; resolve it. bin/ and libexec/ are siblings. (share/
# is templates and examples for a human; nothing here reads it.)
_argv0=${0##*/}                    # the name we were INVOKED as (the shim key)
_self=$0
case $_self in
*/*) ;;
*) _self=$(command -v -- "$_self" 2>/dev/null || echo "$_self") ;;
esac
VALET_KEY_SELF=$(readlink -f -- "$_self" 2>/dev/null || echo "$_self")
export VALET_KEY_SELF          # adapters skip this path finding the real binary
LIBEXEC=${VALET_KEY_SELF%/*}/../libexec
SLOTS="$LIBEXEC/slots"
# Shared adapter helpers (realbin_from), sourced once before any adapter is.
# Kept OUT of libexec/adapters/ on purpose: one file there is one agent.
. "$LIBEXEC/adapter.sh"
VALET_KEY_CONFIG=${VALET_KEY_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}\
/valet-key}
DEFAULT_PROFILE=${VALET_KEY_DEFAULT_PROFILE:-personal}
# Where the shims live -- a dir the user puts FIRST on PATH so a shim shadows
# the real binary (no collision; distinct from ~/.local/bin). An integrator can
# point this at a dir it already owns first (tackup: ~/bin).
_shimdef=${XDG_DATA_HOME:-$HOME/.local/share}/valet-key/shims
VALET_KEY_SHIMS_DIR=${VALET_KEY_SHIMS_DIR:-$_shimdef}

die() { echo "valet-key: $*" >&2; exit 1; }

# --- marker output (self-painted) --------------------------------------------
# check + doctor speak the [OK]/[FAIL]/[WARN]/[IGNORE] MARKER contract: an
# integrator styles the plain markers in its own palette (tackup's `paint`);
# standalone at a terminal we colour them ourselves, and stay plain when piped
# or under NO_COLOR. Self-contained -- the markers are a string convention, not
# a dependency on any integrator's styling code.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _mke=$(printf '\033')
  _MG="$_mke[1;32m"; _MR="$_mke[1;31m"; _MY="$_mke[1;33m"
  _MD="$_mke[2m";    _MO="$_mke[0m"
else
  _MG=; _MR=; _MY=; _MD=; _MO=
fi
mk_ok()   { printf '  %s[OK]%s   %s\n'   "$_MG" "$_MO" "$1"; }
mk_bad()  { printf '  %s[FAIL]%s %s\n'   "$_MR" "$_MO" "$1"; }
mk_warn() { printf '  %s[WARN]%s %s\n'   "$_MY" "$_MO" "$1"; }
mk_note() { printf '  %s[IGNORE]%s %s\n' "$_MD" "$_MO" "$1"; }
mk_fix()  { printf '        %s\n' "$1"; }

# --- adapter -----------------------------------------------------------------
# Load agent <name>'s adapter (sets ADAPTER_*), and export the slot-pool file
# policy the slots lib reads. Fail loud on an unknown agent.
load_adapter() {
  _a=$LIBEXEC/adapters/$1
  [ -r "$_a" ] || die "no adapter for agent '$1' ($_a)"
  AGENT=$1
  # Clear every adapter-supplied var first, so loading a SECOND adapter in one
  # process (e.g. `doctor`/`check` sweeping all agents) can't inherit the
  # previous adapter's value for a knob this one legitimately omits.
  unset ADAPTER_ENV ADAPTER_BASE ADAPTER_SLOTS ADAPTER_CRED_FILE \
        ADAPTER_STATIC_FILES ADAPTER_SEED_FILES ADAPTER_PROC_MATCH \
        ADAPTER_UNSET_ENV ADAPTER_LOGIN_ARGS ADAPTER_EXP_PATTERN ADAPTER_QUIET
  . "$_a"
  # The slot-pool vars are only read when ADAPTER_SLOTS=1; a non-agent adapter
  # (e.g. gcloud, slots=0) legitimately omits them, so default to empty here.
  export VALET_KEY_CRED_FILE=${ADAPTER_CRED_FILE:-}
  export VALET_KEY_STATIC_FILES=${ADAPTER_STATIC_FILES:-}
  export VALET_KEY_SEED_FILES=${ADAPTER_SEED_FILES:-}
  export VALET_KEY_PROC_MATCH=${ADAPTER_PROC_MATCH:-}
  export VALET_KEY_CRED_ENV=$ADAPTER_ENV
  # Generic per-agent knobs (empty = the neutral default): env vars to scrub at
  # launch/login, extra args for the login command, and the sed pattern the
  # slots lib reads a slot's hard-cap expiry with.
  export VALET_KEY_UNSET_ENV=${ADAPTER_UNSET_ENV:-}
  export VALET_KEY_LOGIN_ARGS=${ADAPTER_LOGIN_ARGS:-}
  export VALET_KEY_EXP_PATTERN=${ADAPTER_EXP_PATTERN:-}
}

# config dir for <profile> with this agent. A per-(agent, profile) OVERRIDE in
# $VALET_KEY_CONFIG/dirs wins ("<agent> <profile> <dir>" lines) -- so an
# integrator
# can pin a dir that must live somewhere specific (a sealed location, or a tool
# like gemini whose env points at a HOME not a config dir). Else the default:
# the base for the default profile, <base>-<profile> otherwise.
profile_dir() {
  if [ -r "$VALET_KEY_CONFIG/dirs" ]; then
    while read -r _oa _op _od _rest; do
      case "$_oa" in ''|'#'*) continue ;; esac
      [ "$_oa" = "$AGENT" ] && [ "$_op" = "$1" ] || continue
      case "$_od" in "~/"*) _od=$HOME/${_od#\~/} ;; '~') _od=$HOME ;; esac
      printf '%s\n' "$_od"; return 0
    done < "$VALET_KEY_CONFIG/dirs"
  fi
  if [ "$1" = "$DEFAULT_PROFILE" ]; then printf '%s\n' "$ADAPTER_BASE"
  else printf '%s\n' "$ADAPTER_BASE-$1"; fi
}

pool_id() { printf '%s/%s\n' "$AGENT" "$1"; }   # <agent>/<profile>

# A profile name becomes a PATH COMPONENT (profile_dir's <base>-<profile>) and
# half a pool id, so it is validated as a DNS label before use: lowercase
# alphanumeric and hyphen, not leading or trailing, 63 max. A hook returning
# `../..` would otherwise choose where valet-key writes. Invalid is an ERROR,
# never a silent fall back to the default -- a mangled profile quietly becoming
# `personal` would route a WORK agent to the personal account, which is the one
# direction this must never fail in.
valid_profile() {   # <name>
  case $1 in
    ''|*[!a-z0-9-]*|-*|*-) return 1 ;;
  esac
  [ "${#1}" -le 63 ]
}

# --- the hook seams ----------------------------------------------------------
# valet-key must decide two things it cannot always know by itself:
#
#   WHICH PROFILE applies here.   Its own answer is a cwd->profile table, which
#                                 is a guess from location; location cannot
#                                 express, say, which unix group this process
#                                 holds.
#   MAY I LAUNCH AT ALL.          Its own answer is "always". Coherence can
#                                 depend on facts valet-key has no view of.
#
# They are irreducibly different: a veto is not a profile name, and a selection
# cannot say "stop". So there are two seams, and a hook's DIRECTORY says which
# question it answers -- no verb argument, no dispatch, and no need to answer a
# question you do not care about. Someone adding "refuse when the VPN is down"
# writes one executable in guard.d and says nothing about profiles.
#
#   $VALET_KEY_HOOKS/profile.d/*   may print a profile name
#   $VALET_KEY_HOOKS/guard.d/*     may veto
#
# Each is run in NAME ORDER with the agent in the environment. Multiple
# providers compose without knowing about each other, which one executable
# answering both questions could never do.
VALET_KEY_HOOKS=${VALET_KEY_HOOKS:-$VALET_KEY_CONFIG/hooks}

# Hooks are iterated by GLOBBING IN PLACE, never by capturing a list and
# splitting it. `for h in $(list_them)` word-splits, so a hook whose path holds
# a space becomes several nonexistent paths, each "fails" -- and both seams
# read a failure as a legitimate answer. Selection would take it as "I cannot
# tell" and move on; a veto that could not run counts as a refusal it never
# made. Either way the hook is gone and nothing says so, which is the failure
# this whole seam is built to avoid. A space in $HOME is ordinary on some
# systems, so this is not a hypothetical path.
#
#   for _hk in "$VALET_KEY_HOOKS/<dir>"/*; do
#     [ -f "$_hk" ] && [ -x "$_hk" ] || continue
#
# A non-executable file is skipped here (it cannot be run); `doctor` reports
# one, because silently skipping it is how a hook comes to look installed
# while never having run.

here_dir() {
  _r=$(git rev-parse --show-toplevel 2>/dev/null || true)
  ( cd "${_r:-$PWD}" 2>/dev/null && pwd -P ) || printf '%s\n' "$PWD"
}

# SELECTION. First hook that ANSWERS wins; the rest are not consulted. A hook
# answers by exiting 0, and its stdout is the answer:
#
#   exit 0 + a name   -> that profile.
#   exit 0 + empty    -> "definitely the default here". A real answer, so the
#                        chain STOPS and the cwd table is not consulted.
#   non-zero          -> "I cannot tell". Only this passes to the next hook,
#                        and after all of them, to the cwd table.
#
# That distinction is the whole reason the status matters. Without it a
# provider that KNOWS the answer is the baseline has no way to say so -- it
# must invent a positive token for the default -- and worse, a BROKEN hook
# becomes indistinguishable from one deliberately saying "baseline", so a
# failed integration silently re-enables guessing instead of surfacing.
resolve_profile() {
  for _hk in "$VALET_KEY_HOOKS/profile.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _p=$(VALET_KEY_AGENT="${AGENT:-}" "$_hk" 2>/dev/null) || continue
    # First line, with surrounding whitespace trimmed. Deliberately NOT a
    # blanket space-strip: that would silently weld "has space" into a
    # legal-looking "hasspace" rather than rejecting it below.
    _p=$(printf '%s' "$_p" | head -1)
    _p=${_p#"${_p%%[![:space:]]*}"}
    _p=${_p%"${_p##*[![:space:]]}"}
    [ -n "$_p" ] || _p=$DEFAULT_PROFILE
    valid_profile "$_p" || {
      echo "valet-key: profile hook returned an invalid profile: '$_p'" >&2
      echo "  $_hk" >&2
      exit 1; }
    printf '%s\n' "$_p"; return 0
  done
  if [ -r "$VALET_KEY_CONFIG/profiles" ]; then
    _h=$(here_dir)
    # "<profile> <matchdir>"; first dir the context sits under wins.
    while read -r _prof _dir _rest; do
      case "$_prof" in ''|'#'*) continue ;; esac
      [ -n "$_dir" ] || continue
      case "$_dir" in "~/"*) _dir=$HOME/${_dir#\~/} ;; '~') _dir=$HOME ;; esac
      _dir=$( ( cd "$_dir" 2>/dev/null && pwd -P ) || true )
      [ -n "$_dir" ] || continue
      case "$_h/" in
        "$_dir"/*)
          # Validated on THIS path too, not just the hook one. The name is
          # about to become a directory component and half a pool id, and a
          # table is edited by hand -- which makes a stray `../` at least as
          # likely here as from a hook. Skipping the check on one of the two
          # inputs would leave the guard looking present while half the doors
          # were open.
          valid_profile "$_prof" || {
            echo "valet-key: $VALET_KEY_CONFIG/profiles:" \
                 "invalid profile name '$_prof'" >&2
            exit 1; }
          printf '%s\n' "$_prof"; return 0 ;;
      esac
    done < "$VALET_KEY_CONFIG/profiles"
  fi
  valid_profile "$DEFAULT_PROFILE" || {
    echo "valet-key: invalid default profile '$DEFAULT_PROFILE'" \
         "(\$VALET_KEY_DEFAULT_PROFILE)" >&2
    exit 1; }
  printf '%s\n' "$DEFAULT_PROFILE"
}

# VETO. EVERY hook runs and ANY refusal refuses. That composition is not a
# style choice: adding a guard must only ever make things stricter, never
# weaker, or a second guard could silently cancel the first. So the strictest
# verdict wins -- any 1 refuses, else any 2 warns, else proceed.
#
# Exit: 0 ok, 2 warn (print, continue), 1 refuse (print, abort). Anything else
# is the hook itself failing, and a failing safety check counts as a REFUSAL:
# a guard that cannot run has not cleared anything. The hook owns the message
# (its stderr passes through).
guard_check() {   # profile
  _worst=0
  for _hk in "$VALET_KEY_HOOKS/guard.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _g=0
    VALET_KEY_AGENT="${AGENT:-}" VALET_KEY_PROFILE="$1" "$_hk" "$1" || _g=$?
    case $_g in
      0) ;;
      2) [ "$_worst" = 0 ] && _worst=2 ;;
      *) _worst=1 ;;
    esac
  done
  [ "$_worst" = 1 ] && exit 1
  return 0
}

# --- run an agent: resolve -> guard -> config dir -> slot -> exec -------------
run_agent() {
  load_adapter "$1"; shift
  _profile=$(resolve_profile)
  guard_check "$_profile"
  _base=$(profile_dir "$_profile")
  _cfg=$_base
  if [ "${ADAPTER_SLOTS:-0}" = 1 ]; then
    _leased=$("$SLOTS" lease "$(pool_id "$_profile")" "$_base" $$ 2>/dev/null) \
      || _leased=""
    [ -n "$_leased" ] && _cfg=$_leased
  fi
  _bin=$(adapter_realbin) || die "$AGENT: real binary not found"
  adapter_preexec
  # Scrub any env the adapter declared as an override of its stored credential
  # (e.g. ANTHROPIC_API_KEY / OPENAI_API_KEY) so the slot's login takes effect.
  for _u in ${VALET_KEY_UNSET_ENV:-}; do unset "$_u"; done
  # Ensure the config dir exists: harmless for agents that create their own, and
  # required for those that error on a missing dir (codex canonicalises it).
  mkdir -p "$_cfg" 2>/dev/null || true
  export "$ADAPTER_ENV=$_cfg"
  # Announce the resolution, unless the adapter is quiet (a scripted tool like
  # gcloud, whose stderr callers parse); VALET_KEY_VERBOSE forces it back on.
  if [ "${ADAPTER_QUIET:-0}" != 1 ] || [ -n "${VALET_KEY_VERBOSE:-}" ]; then
    printf 'valet-key: %s profile=%s config=%s\n' \
      "$AGENT" "$_profile" "$_cfg" >&2
  fi
  exec "$_bin" "$@"
}

# --- management --------------------------------------------------------------
# provision/login/check resolve the pool (agent, profile) then hand id+base to
# slots, also exporting the real binary for the interactive login verbs.
#
# ONE RULE FOR "WHICH PROFILE". A profile named on the command line is used as
# given; omitted, it is RESOLVED exactly as a launch here would resolve it.
# These three used to disagree -- login resolved, provision and check fell back
# to the default -- so `cd ~/work && valet-key provision claude` provisioned
# PERSONAL while `valet-key login` one line later acted on WORK. Nothing said
# so, and the pool you thought you had built was somewhere else. A tool whose
# entire job is picking the right account cannot have two answers to where
# "here" is.
#
# Because the answer now depends on context, every one of them PRINTS the pool
# it settled on. Resolution that is silent is resolution you cannot check.
resolve_pool() {   # <profile-or-empty> -- echo the profile, validated
  if [ -n "${1:-}" ]; then
    valid_profile "$1" || die "invalid profile name '$1'"
    printf '%s\n' "$1"
  else
    resolve_profile
  fi
}

m_provision() {
  load_adapter "${1:?agent required}"
  _prof=$(resolve_pool "${2:-}"); _n=${3:-5}
  echo "valet-key: provisioning $(pool_id "$_prof")"
  "$SLOTS" provision "$(pool_id "$_prof")" "$(profile_dir "$_prof")" "$_n"
}
# valet-key login [warm|check|force|stale] [agent] [profile]
#   warm (default) log into the next COLD slot; check  warm/total + cap ages;
#   force re-login the OLDEST warm slot; stale re-login slots near the cap.
m_login() {
  _act=warm
  case "${1:-}" in warm|check|force|stale) _act=$1; shift || true ;; esac
  load_adapter "${1:-claude}"
  _prof=$(resolve_pool "${2:-}")
  VALET_KEY_AGENT_BIN=$(adapter_realbin) || die "$AGENT: real binary not found"
  export VALET_KEY_AGENT_BIN
  _id=$(pool_id "$_prof"); _base=$(profile_dir "$_prof")
  echo "valet-key: login $_act on $_id"
  case $_act in
    warm)  "$SLOTS" warm        "$_id" "$_base" ;;
    check) "$SLOTS" login-check  "$_id" "$_base" ;;
    force) "$SLOTS" force        "$_id" "$_base" ;;
    stale) "$SLOTS" login-stale  "$_id" "$_base" ;;
  esac
}
# resolve: what WOULD happen here, without launching anything.
#
# The tool's entire job is choosing an account, and until this existed the only
# way to find out which one it had chosen was to LAUNCH THE AGENT and read the
# announce line off its stderr -- that is, to run the thing you were trying to
# check first. Worse, when routing surprised you there was no way to see why.
#
# So this shows the working, not just the answer: which hook answered, which
# ones were never asked because an earlier one did, what the guards say, and
# whether the pool is actually there. Exits 1 if a guard would refuse, so
# `valet-key resolve && ...` means what it looks like it means.
m_resolve() {
  load_adapter "${1:-claude}"
  _prof=$(resolve_profile)
  _base=$(profile_dir "$_prof")
  echo "valet-key resolve"
  echo
  printf '  agent    %s\n' "$AGENT"
  printf '  context  %s\n' "$(here_dir)"
  printf '  profile  %s\n' "$_prof"
  printf '  config   %s\n' "$_base"
  if [ "${ADAPTER_SLOTS:-0}" = 1 ]; then
    _c=$("$SLOTS" counts "$(pool_id "$_prof")" 2>/dev/null || echo "0 0 0")
    _t=${_c%% *}; _r=${_c#* }; _cw=${_r%% *}; _l=${_r##* }
    if [ "$_t" -gt 0 ]; then
      printf '  pool     %s -- %s slots, %s warm, %s leased\n' \
        "$(pool_id "$_prof")" "$_t" "$_cw" "$_l"
    else
      printf '  pool     %s -- NONE (this session would share the base dir)\n' \
        "$(pool_id "$_prof")"
    fi
  else
    printf '  pool     none (this agent is poolless by design)\n'
  fi

  echo; echo "selection (first hook to ANSWER wins; then the cwd table)"
  _seen=0; _any=0
  for _hk in "$VALET_KEY_HOOKS/profile.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _any=1
    if [ "$_seen" = 1 ]; then
      mk_note "profile.d/${_hk##*/} (not consulted; an earlier hook answered)"
      continue
    fi
    _rc=0; _o=$(VALET_KEY_AGENT="$AGENT" "$_hk" 2>/dev/null) || _rc=$?
    _o=$(printf '%s' "$_o" | head -1 | tr -d '[:space:]')
    if [ "$_rc" = 0 ]; then
      _seen=1
      mk_ok "profile.d/${_hk##*/} -> ${_o:-(empty: the default)}"
    else
      mk_note "profile.d/${_hk##*/} abstains (exit $_rc)"
    fi
  done
  [ "$_any" = 1 ] || mk_note "no profile.d hooks"
  if [ "$_seen" = 1 ]; then
    mk_note "$VALET_KEY_CONFIG/profiles (not consulted; a hook answered)"
  elif [ -r "$VALET_KEY_CONFIG/profiles" ]; then
    mk_ok "$VALET_KEY_CONFIG/profiles -> $_prof"
  else
    mk_note "no profiles table; the default profile applies"
  fi

  echo; echo "guards (EVERY one runs; any refusal wins)"
  _worst=0; _any=0
  for _hk in "$VALET_KEY_HOOKS/guard.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _any=1; _g=0
    _msg=$(VALET_KEY_AGENT="$AGENT" VALET_KEY_PROFILE="$_prof" \
      "$_hk" "$_prof" 2>&1 >/dev/null) || _g=$?
    case $_g in
      0) mk_ok "guard.d/${_hk##*/} allows" ;;
      2) mk_warn "guard.d/${_hk##*/} warns${_msg:+: $_msg}"
         [ "$_worst" = 0 ] && _worst=2 ;;
      *) mk_bad "guard.d/${_hk##*/} REFUSES${_msg:+: $_msg}"; _worst=1 ;;
    esac
  done
  [ "$_any" = 1 ] || mk_note "no guard.d hooks; nothing refuses"

  echo
  case $_worst in
    1) echo "valet-key: this launch would be REFUSED."; return 1 ;;
    2) echo "valet-key: this launch would proceed, with a warning." ;;
    *) echo "valet-key: this launch would proceed." ;;
  esac
  return 0
}

# check: one pool with an agent arg; with NO args, the whole provisioned setup
# (every pool). The declarative DRIFT audit -- what provisioning owns and can
# re-fix. Non-zero on any missing pool or structural drift.
m_check() {
  [ $# -gt 0 ] || { check_all; return; }
  load_adapter "${1:?agent required}"; _prof=$(resolve_pool "${2:-}")
  _check_pool "$(pool_id "$_prof")" "$(profile_dir "$_prof")"
}

# stale, across every pool, with the RIGHT adapter loaded for each. The scan
# reads a per-agent credential file with a per-agent pattern, so doing it in
# one pass with whatever adapter happened to be loaded last reports "cap
# unknown" for every other agent -- a silent no-op in the one feature whose
# entire job is to speak up before a slot goes cold.
m_stale() {
  for _ag in $(list_agents); do
    [ -r "$LIBEXEC/adapters/$_ag" ] || continue
    load_adapter "$_ag"
    [ "${ADAPTER_SLOTS:-0}" = 1 ] || continue
    "$SLOTS" stale "$_ag" || true
  done
}

# Every profile name valet-key could route to on this box: the default, plus
# whatever the two config tables name. Deliberately NOT "profiles that have
# pools" -- the entire point of the caller is to find the ones that do not.
#
# A profile can also arrive from a profile.d hook, and those cannot be
# enumerated: a hook is a program, and asking it what it MIGHT answer is not a
# question it has an interface for. So this covers the declarative sources,
# which is where a profile someone forgot to provision realistically comes
# from.
known_profiles() {
  printf '%s\n' "$DEFAULT_PROFILE"
  if [ -r "$VALET_KEY_CONFIG/profiles" ]; then
    while read -r _kp _krest; do
      case "$_kp" in ''|'#'*) continue ;; esac
      if valid_profile "$_kp"; then printf '%s\n' "$_kp"; fi
    done < "$VALET_KEY_CONFIG/profiles"
  fi
  if [ -r "$VALET_KEY_CONFIG/dirs" ]; then
    while read -r _ka _kp _krest; do
      case "$_ka" in ''|'#'*) continue ;; esac
      if valid_profile "${_kp:-}"; then printf '%s\n' "$_kp"; fi
    done < "$VALET_KEY_CONFIG/dirs"
  fi
}

# Every installed agent (one adapter file == one agent valet-key knows).
list_agents() {
  for _a in "$LIBEXEC"/adapters/*; do
    [ -r "$_a" ] && printf '%s\n' "${_a##*/}"
  done
}

# Audit one pool -> one MARKER line (its agent adapter must be loaded first, so
# the slot lib counts warm with the right CRED file). Non-zero on drift.
_check_pool() {   # <id> <base>
  if _o=$("$SLOTS" check "$1" "$2" 2>&1); then
    mk_ok "$1 -- ${_o#*-- }"; return 0
  fi
  _r=$(printf '%s' "$_o" | grep -iE 'missing|dangling|drift' | head -1)
  mk_bad "$1 -- ${_r:-drift}"; return 1
}

# check_all: audit every provisioned pool, one marker line each.
check_all() {
  _rc=0; _any=0
  for _p in $("$SLOTS" pools); do
    _any=1; _ag=${_p%%/*}; _pr=${_p#*/}
    if [ -r "$LIBEXEC/adapters/$_ag" ]; then
      load_adapter "$_ag"
      _check_pool "$_p" "$(profile_dir "$_pr")" || _rc=1
    else
      mk_bad "$_p: no adapter for '$_ag'"; _rc=1
    fi
  done
  [ "$_any" = 1 ] || mk_note "no pools provisioned"
  return "$_rc"
}

# doctor output helpers -- the same [OK]/[FAIL]/[WARN]/[IGNORE] markers as
# check, plus the m_doctor-scoped counters _warn/_fail (dash has no locals; they
# are plain globals set by m_doctor).
_dok()   { mk_ok "$1"; }
_dna()   { mk_note "$1"; }
_dwarn() { mk_warn "$1"; _warn=$((_warn + 1)); }
_dfail() { mk_bad "$1"; _fail=$((_fail + 1)); }
_dfix()  { mk_fix "$1"; }

# Are the OPTIONAL hooks, if installed, actually working? valet-key owns this
# question: it declared the seams, so it is the only thing that can tell a hook
# that ANSWERS from one that is merely failing.
#
# It matters because both seams treat failure as a legitimate answer BY DESIGN.
# A profile hook that exits non-zero means "I cannot tell" and is skipped; a
# guard that exits non-zero refuses. So a hook broken by its provider renaming
# a verb keeps "working" in the sense that nothing errors -- while selection
# has silently fallen back to guessing, or every launch is being refused for
# the wrong reason. That happened.
#
# Deliberately GENERIC: nothing here knows or names any particular provider. It
# asks only what the contract promises.
_doctor_hooks() {
  echo; echo "hooks (optional; profile.d selects, guard.d vetoes)"

  # A file at the OLD single-hook path is no longer consulted. Silently
  # ignoring it would leave someone believing a boundary is enforced when it
  # is not, which is the worst failure this seam has.
  if [ -e "$VALET_KEY_CONFIG/context" ]; then
    _dfail "$VALET_KEY_CONFIG/context is no longer read"
    _dfix "split it: a selector in hooks/profile.d, a veto in hooks/guard.d"
  fi

  _any=0

  # A file sitting in a hooks dir WITHOUT the executable bit is invisible:
  # the glob above tests -x, so selection never runs it, guard never does
  # every check below would report "no hooks" while the file sits there
  # looking installed. It is the same failure as the retired path above --
  # someone believes a boundary is enforced and nothing is reading it -- and
  # the likeliest way to reach it, since dropping in a hook and forgetting
  # the chmod is one missed step, not a rename.
  for _d in profile.d guard.d; do
    [ -d "$VALET_KEY_HOOKS/$_d" ] || continue
    for _hk in "$VALET_KEY_HOOKS/$_d"/*; do
      [ -f "$_hk" ] && [ ! -x "$_hk" ] || continue
      _any=1
      _dfail "$_d/${_hk##*/} is not executable, so nothing runs it"
      _dfix "chmod +x $_hk"
    done
  done

  for _hk in "$VALET_KEY_HOOKS/profile.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _any=1
    _err=$(VALET_KEY_AGENT=doctor "$_hk" 2>&1 >/dev/null) || true
    _rc=0; VALET_KEY_AGENT=doctor "$_hk" >/dev/null 2>&1 || _rc=$?
    _out=$(VALET_KEY_AGENT=doctor "$_hk" 2>/dev/null | head -1 \
           | tr -d '[:space:]') || true
    if [ -n "$_err" ]; then
      # A hook that answers is QUIET. Noise on stderr is it complaining, and
      # the complaint is invisible in use: selection discards stderr and moves
      # on to the next hook.
      _dfail "profile.d/${_hk##*/} writes to stderr: $_err"
    elif [ "$_rc" = 0 ] && [ -n "$_out" ] && ! valid_profile "$_out"; then
      _dfail "profile.d/${_hk##*/} returned an unusable profile: '$_out'"
    elif [ "$_rc" = 0 ]; then
      _dok "profile.d/${_hk##*/} answers${_out:+ ($_out)}"
    else
      _dok "profile.d/${_hk##*/} abstains (exit $_rc)"
    fi
  done

  for _hk in "$VALET_KEY_HOOKS/guard.d"/*; do
    [ -f "$_hk" ] && [ -x "$_hk" ] || continue
    _any=1
    _rc=0
    VALET_KEY_AGENT=doctor VALET_KEY_PROFILE="$DEFAULT_PROFILE" \
      "$_hk" "$DEFAULT_PROFILE" >/dev/null 2>&1 || _rc=$?
    case $_rc in
      0) _dok "guard.d/${_hk##*/} allows the default profile" ;;
      1) _dok "guard.d/${_hk##*/} refuses here (exit 1)" ;;
      2) _dok "guard.d/${_hk##*/} warns here (exit 2)" ;;
      *) _dfail "guard.d/${_hk##*/} exited $_rc (expected 0, 1 or 2)"
         _dfix "a guard that cannot run counts as a REFUSAL" ;;
    esac
  done

  [ "$_any" = 0 ] && _dna "no hooks; the built-in directory rule decides"
  return 0
}

# doctor: the ENVIRONMENTAL sweep -- the runtime health valet-key can neither
# provision nor repair (PATH order, leaked API keys, pool saturation, slots near
# their cap). Read-only, launches nothing; complements `check` (declarative
# drift) as a readiness probe complements a provisioner. Exits non-zero on a
# real BREAKAGE -- a shim that does not intercept, or a hook that is not being
# read or is answering outside its contract. Everything else (a leaked API key,
# a saturated pool, a slot near its cap) is an advisory and does not.
m_doctor() {
  _fail=0; _warn=0
  echo "valet-key doctor"

  echo; echo "shims (does typing the agent route through valet-key?)"
  for _ag in $(list_agents); do
    _w=$(command -v "$_ag" 2>/dev/null || true)
    if [ -z "$_w" ]; then
      _dna "$_ag: not on PATH (agent not installed)"
    elif [ "$(readlink -f "$_w" 2>/dev/null)" = "$VALET_KEY_SELF" ]; then
      _dok "$_ag routes through valet-key"
    else
      _dfail "$_ag resolves to $_w, not the shim"
      _dfix 'put the shims dir first on PATH: eval "$(valet-key init)"'
    fi
  done

  echo; echo "environment (creds that would override a slot login)"
  _leak=0
  for _ag in $(list_agents); do
    load_adapter "$_ag"
    for _k in ${VALET_KEY_UNSET_ENV:-}; do
      eval "_v=\${$_k:-}"
      if [ -n "$_v" ]; then
        _dwarn "$_ag: \$$_k is set (overrides the login on a direct run)"
        _leak=1
      fi
    done
  done
  [ "$_leak" = 0 ] && _dok "no agent API key leaking into the environment"

  echo; echo "pools"
  _any=0
  for _p in $("$SLOTS" pools); do
    _any=1; _ag=${_p%%/*}
    [ -r "$LIBEXEC/adapters/$_ag" ] || { _dwarn "$_p: no adapter"; continue; }
    load_adapter "$_ag"
    _c=$("$SLOTS" counts "$_p" 2>/dev/null || echo "0 0 0")
    _t=${_c%% *}; _r=${_c#* }; _cw=${_r%% *}; _l=${_r##* }
    if [ "$_t" -gt 0 ] && [ "$_l" -ge "$_t" ]; then
      _dwarn "$_p saturated: $_l/$_t leased (next launch overflows to base)"
      _dfix "raise it: valet-key provision $_ag ${_p#*/} <N>"
    else
      _dok "$_p: $_cw/$_t warm, $_l leased"
    fi
  done
  [ "$_any" = 1 ] || _dna "no pools provisioned"

  # A profile you can actually reach, with NO pool behind it. This is the
  # tool's central promise quietly unmet: with no pool, `lease` hands back the
  # shared base dir, and it does so SILENTLY on the launch path -- so every
  # session for that profile shares one credentials file exactly as it would
  # if valet-key had never been installed. The logins start knocking each
  # other out again and the tool that was supposed to stop that says nothing.
  #
  # Nothing else can catch it. `check` audits pools that EXIST, and this
  # failure's whole shape is a pool that does not.
  for _ag in $(list_agents); do
    load_adapter "$_ag"
    [ "${ADAPTER_SLOTS:-0}" = 1 ] || continue      # poolless agents: fine
    for _pr in $(known_profiles | sort -u); do
      _pdir=$(profile_dir "$_pr")
      # Only where the account dir EXISTS. A profile named in a table but not
      # yet logged into is an ordinary half-finished setup, not a fault, and
      # warning about every agent x every profile would bury the real ones.
      [ -d "$_pdir" ] || continue
      "$SLOTS" counts "$_ag/$_pr" >/dev/null 2>&1 && continue
      _dwarn "$_ag/$_pr has no pool; sessions share $_pdir"
      _dfix "valet-key provision $_ag $_pr"
    done
  done

  _st=$(m_stale 2>/dev/null || true)
  if [ -n "$_st" ]; then
    _oifs=$IFS; IFS='
'
    for _line in $_st; do _dwarn "near cap: $_line"; done
    IFS=$_oifs
    _dfix "re-login: valet-key login stale"
  fi

  _doctor_hooks

  echo
  echo "valet-key doctor: $_warn warning(s), $_fail problem(s)"
  [ "$_fail" -eq 0 ]
}

# --- shims: intercept an agent command by name -------------------------------
# A shim is a symlink named <agent> in the shims dir, pointing at this engine;
# invoked, its $0 basename is the agent, so run_agent dispatches. The shims dir
# must be FIRST on PATH (valet-key init) so the shim wins over the real binary.
m_shim() {
  [ $# -gt 0 ] || die "usage: valet-key shim <agent>..."
  mkdir -p "$VALET_KEY_SHIMS_DIR"
  for _ag in "$@"; do
    [ -r "$LIBEXEC/adapters/$_ag" ] || die "no adapter for agent '$_ag'"
    ln -sfn "$VALET_KEY_SELF" "$VALET_KEY_SHIMS_DIR/$_ag"
    echo "valet-key: shimmed $_ag -> $VALET_KEY_SHIMS_DIR/$_ag"
    _w=$(command -v "$_ag" 2>/dev/null || true)
    if [ "$_w" != "$VALET_KEY_SHIMS_DIR/$_ag" ]; then
      echo "valet-key: note: '$_ag' still resolves to ${_w:-nothing}; put the" \
           "shims dir first on PATH (eval \"\$(valet-key init)\")." >&2
    fi
  done
}
m_unshim() {
  [ $# -gt 0 ] || die "usage: valet-key unshim <agent>..."
  for _ag in "$@"; do
    if [ -L "$VALET_KEY_SHIMS_DIR/$_ag" ]; then
      rm -f "$VALET_KEY_SHIMS_DIR/$_ag"; echo "valet-key: unshimmed $_ag"
    else echo "valet-key: no shim for '$_ag'" >&2; fi
  done
}
m_shims() {
  [ -d "$VALET_KEY_SHIMS_DIR" ] || return 0
  for _s in "$VALET_KEY_SHIMS_DIR"/*; do
    [ -L "$_s" ] || continue
    printf '%s -> %s\n' "${_s##*/}" "$(readlink "$_s")"
  done
}
m_rehash() {
  [ -d "$VALET_KEY_SHIMS_DIR" ] ||
    { echo "valet-key: no shims dir yet"; return 0; }
  for _s in "$VALET_KEY_SHIMS_DIR"/*; do
    [ -L "$_s" ] && ln -sfn "$VALET_KEY_SELF" "$_s"
  done
  echo "valet-key: rehashed shims in $VALET_KEY_SHIMS_DIR"
}
m_init() { printf 'export PATH="%s:$PATH"\n' "$VALET_KEY_SHIMS_DIR"; }

# Dispatch: invoked as a shim (name != valet-key) -> run that agent. As
# `valet-key` ->
# the management CLI.
if [ "$_argv0" != valet-key ]; then
  run_agent "$_argv0" "$@"
fi

_v=${1:-}; [ $# -gt 0 ] && shift || true
case "$_v" in
  run)        run_agent "$@" ;;
  provision)  m_provision "$@" ;;
  login)      m_login "$@" ;;
  check)      m_check "$@" ;;
  resolve)    m_resolve "$@" ;;
  doctor)     m_doctor ;;
  stale)      m_stale ;;
  slots)      "$SLOTS" "$@" ;;
  shim)       m_shim "$@" ;;
  unshim)     m_unshim "$@" ;;
  shims)      m_shims ;;
  rehash)     m_rehash ;;
  init)       m_init ;;
  shims-dir)  printf '%s\n' "$VALET_KEY_SHIMS_DIR" ;;
  # The usage text IS the header comment: one source of truth, so a verb
  # cannot be added without the help growing a line. Where that comment ENDS
  # is FOUND, not written down -- the range runs to `set -eu` and then keeps
  # only the comment lines. A hardcoded last-line number is the same fact
  # stored twice, and it drifts the moment anyone adds a line up there, which
  # is exactly what happened when `resolve` was added.
  ''|help|-h|--help)
    sed -n '2,/^set -eu$/p' "$VALET_KEY_SELF" | sed -n 's/^# \{0,1\}//p' ;;
  *) die "unknown command '$_v' (try: valet-key help)" ;;
esac
