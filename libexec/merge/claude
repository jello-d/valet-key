#!/usr/bin/env python3
"""Reconcile Claude Code's .claude.json across one pool's config dirs.

WHY THIS EXISTS. A slot's .claude.json is a PRIVATE COPY, not a symlink,
because the agent rewrites it constantly and N sessions sharing one inode
would interleave read-modify-write and lose each other's edits. That is the
right call -- but it means everything the agent records there is per-slot, and
`projects[<path>]` is where trust, per-project allowed tools and MCP approvals
live. So the same repo has to be trusted again on every slot it has not been
opened in yet, and a freshly provisioned slot starts knowing nothing.

So: keep the private copies, and RECONCILE them. Safer than sharing an inode,
because every writer still owns its own file; the worst case is a merge that
loses a cycle and is redone on the next one, never a corrupted config.

WHAT IT MERGES, AND WHAT IT REFUSES TO. Only `projects`. Everything else in
each destination is left exactly as found -- oauthAccount and userID above all,
which are identity and must never move even between slots of one pool, and the
counters and caches, for which a merge would be meaningless.

WHICH COPY WINS, AND WHY IT IS NOT SIMPLY THE NEWEST FILE. The first version of
this used file mtime as the clock: newest file wins, per project. That is
WRONG, and it cost real grants. A file's mtime says when ANY part of it last
changed, so a busy slot -- one with a live session bumping a counter every few
seconds -- becomes "newest" for EVERY project it contains, including ones it
has never been opened in and knows nothing about. Its untouched
`hasTrustDialogAccepted: false` stub then beat another slot's real grant, and
trust came back to be re-answered after every reboot.

The clock has to be per ENTRY, and the file gives us none. So we keep our own:
STATE records the value each project converged on last time. A member's entry
competes only if it DIFFERS from that -- which is precisely "this member
changed it since we last agreed". An untouched stub is identical to what the
last merge handed out, so it cannot win. If nobody changed a project, the
converged value stands, however many times the files around it were rewritten.

That also keeps REVOCATION working, which a union would not: removing trust,
or removing an allowed tool, is a real change, so it competes and wins. Entries
are taken whole from the winner; the union is only ACROSS project keys, so a
new project propagates while an edit replaces rather than accumulates. A
mechanism that resurrects revoked permissions would be worse than the problem
it solves.

Only when two members changed the SAME project since the last merge does mtime
break the tie, which is the narrow case it is actually fit for.

Usage:
  merge/claude [--check] <file> <state> <memberdir>...

The whole partition is handled in ONE invocation, deliberately: the state must
be written once, after every member is updated, or the second destination would
read a state the first had already advanced and mistake unchanged entries for
new ones.

Exit: 0 ok / current, 1 (--check only) some member is behind, 2 error.
"""

import hashlib
import json
import os
import sys
import tempfile

# The only key reconciled. Deliberately an allowlist: a new top-level key that
# Claude Code starts writing must not silently become something we copy
# between config directories.
RECONCILED = "projects"

SUPPORTED = (".claude.json",)

# Files that can be ADOPTED: folded out of a private per-slot copy into the
# shared one, without losing anything. Only an APPEND-ONLY log qualifies --
# its records accumulate and are never rewritten, so a union of two copies is
# exactly their combined history. A read-modify-write document like
# .claude.json emphatically does not: unioning two versions of it would mean
# nothing coherent.
ADOPTABLE = ("history.jsonl",)

GRANT = "hasTrustDialogAccepted"


def load(path):
    """(document, mtime), or (None, 0) if unreadable or mid-write.

    A source being written right now can be caught half-flushed. Skipping it
    is correct: the copy is transient, its owner will write it again, and the
    next reconcile picks it up. Failing the whole run over one torn read would
    make this fragile exactly when the pool is busiest.
    """
    try:
        with open(path, "r") as fh:
            return json.load(fh), os.path.getmtime(path)
    except (OSError, ValueError):
        return None, 0


def same(a, b):
    """Compare two project entries by value, order-insensitively."""
    return (json.dumps(a, sort_keys=True) == json.dumps(b, sort_keys=True))


def write_atomically(path, doc):
    """Replace <path> in one step, preserving its mode.

    tmp + rename so a reader never sees a partial file: an agent may be about
    to be exec'd against this directory, and a truncated config would be a
    hard failure at the worst possible moment.
    """
    try:
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        mode = 0o600
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                               prefix=".vk-merge-")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(doc, fh, indent=2)
            fh.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def choose(key, candidates, previous, bootstrap):
    """Pick the winning entry for one project.

    <candidates> is [(mtime, entry)] from members that CHANGED this project
    since the last merge. Empty means nobody did, so the converged value
    stands regardless of how often the files were rewritten -- that is the
    whole point.
    """
    if not candidates:
        return previous.get(key)
    if bootstrap:
        # No state yet, so no provenance: we cannot tell a grant from a stub
        # that was never asked. Prefer the grant. A `true` is a deliberate
        # human answer, a `false` is usually "never prompted here", and this
        # runs exactly once per pool -- from the next merge on, provenance
        # decides and a revocation wins normally.
        granted = [c for c in candidates if c[1].get(GRANT) is True]
        if granted:
            return max(granted, key=lambda c: c[0])[1]
    return max(candidates, key=lambda c: c[0])[1]


def adopt(name, dst, src):
    """Fold <src> into <dst>, losing nothing, and leave <dst> ordered.

    The migration path for a file moving from private-per-slot to shared. The
    slot's copy holds records NOTHING else has -- 754 prompts on the pool this
    was written for -- so it is merged into the shared file, never discarded.
    Idempotent: adopting twice is adopting once, because the union dedupes.
    """
    if name not in ADOPTABLE:
        return 2
    seen, out = set(), []
    for path in (dst, src):
        try:
            fh = open(path, "r")
        except OSError:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    key = json.dumps(json.loads(line), sort_keys=True)
                except ValueError:
                    continue          # a torn line is dropped, not fatal
                if key in seen:
                    continue
                seen.add(key)
                out.append(json.loads(line))
    if not out:
        return 0
    # Timestamp order, so recall reads as one history rather than as two
    # spliced together.
    out.sort(key=lambda j: j.get("timestamp") or 0)
    body = "".join(json.dumps(j) + "\n" for j in out)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst) or ".",
                               prefix=".vk-adopt-")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(body)
        try:
            os.chmod(tmp, os.stat(dst).st_mode & 0o777)
        except OSError:
            os.chmod(tmp, 0o600)
        os.replace(tmp, dst)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return 0


def main(argv):
    check = False
    if argv and argv[0] == "--adopt":
        if len(argv) != 4:
            sys.stderr.write("usage: merge/claude --adopt <file> <dst> <src>\n")
            return 2
        return adopt(argv[1], argv[2], argv[3])
    if argv and argv[0] == "--check":
        check, argv = True, argv[1:]
    if len(argv) < 3:
        sys.stderr.write("usage: merge/claude [--check] <file> <state> "
                         "<memberdir>...\n")
        return 2

    name, statepath, members = argv[0], argv[1], argv[2:]
    if name not in SUPPORTED:
        sys.stderr.write("merge/claude: cannot reconcile '%s'\n" % name)
        return 2

    state, _ = load(statepath)
    previous = (state or {}).get("merged", {})
    bootstrap = state is None

    # Read every member once. A member with no copy is skipped, not invented:
    # creating one would have to fabricate the identity and onboarding state
    # this deliberately never touches.
    docs = {}
    for d in members:
        doc, mtime = load(os.path.join(d, name))
        if doc is not None:
            docs[d] = (doc, mtime, doc.get(RECONCILED) or {})
    if not docs:
        return 0

    merged = {}
    for key in {k for _, _, pr in docs.values() for k in pr}:
        candidates = [(mtime, pr[key]) for _, mtime, pr in docs.values()
                      if key in pr and not same(pr[key], previous.get(key))]
        won = choose(key, candidates, previous, bootstrap)
        if won is not None:
            merged[key] = won

    behind = [d for d, (_, _, pr) in docs.items() if not same(pr, merged)]
    if check:
        for d in sorted(behind):
            sys.stdout.write("%s is behind\n" % os.path.join(d, name))
        return 1 if behind else 0

    for d in sorted(behind):
        doc = dict(docs[d][0])
        doc[RECONCILED] = merged
        write_atomically(os.path.join(d, name), doc)
        sys.stdout.write("%s: reconciled\n" % os.path.join(d, name))

    # Only now, with every member carrying it, does this become the value we
    # will treat as "agreed" next time.
    try:
        write_atomically(statepath, {"merged": merged})
    except OSError as exc:
        sys.stderr.write("merge/claude: could not record state: %s\n" % exc)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:                       # never abort a launch
        sys.stderr.write("merge/claude: %s\n" % exc)
        sys.exit(2)
