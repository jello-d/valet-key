# valet-key adapter: Claude Code.
#
# Sourced by the engine (bin/valet-key). Declares how this agent stores its
# config,
# which file the slot pool must isolate, how to find the real binary, and any
# launch-time env. The engine reads the ADAPTER_* vars and calls adapter_*().

ADAPTER_ENV=CLAUDE_CONFIG_DIR      # env var pointing the agent at a config
ADAPTER_BASE=$HOME/.claude         # the default profile's config dir
ADAPTER_SLOTS=1                    # Claude's OAuth refresh token rotates

# Slot file policy (see libexec/slots). Claude Code specifics.
ADAPTER_CRED_FILE=.credentials.json
# history.jsonl is the PROMPT-RECALL log, and it is shared rather than private
# despite being agent-written. The rule for that split is not "who writes it"
# but "can concurrent writers corrupt it" -- and an APPEND-ONLY log is the one
# agent-written shape where they cannot, because appends do not conflict.
# Verified on this agent: writes land in place on the same inode, one write()
# per entry, largest entry well under PIPE_BUF.
#
# Left private it fragments: each slot recalls only what it happened to type,
# so up-arrow returns a different past depending on which slot you drew. That
# is a side effect of pooling, and sharing the file removes it exactly --
# restoring the one-file behaviour you would have without a pool.
ADAPTER_STATIC_FILES='settings.json settings.local.json CLAUDE.md history.jsonl'
ADAPTER_SEED_FILES=.claude.json
ADAPTER_PROC_MATCH=claude          # cmdline match for the dead-slot reclaim
# Files that are agent-written (so they cannot be shared by symlink) but whose
# contents SHOULD be common to the pool. .claude.json carries projects[<path>]
# -- trust, per-project allowed tools, MCP approvals -- which is per-slot state
# nobody wants to be per-slot: the same repo asks to be trusted again on every
# slot it has not been opened in. libexec/merge/claude reconciles them.
ADAPTER_MERGE_FILES=.claude.json

# ANTHROPIC_API_KEY silently overrides the OAuth login, so a slot's per-session
# credential never takes effect while it is set: unset it at launch AND before a
# slot login. Declared (not unset in adapter_preexec) so the slots lib honours
# it for `valet-key login` too.
ADAPTER_UNSET_ENV=ANTHROPIC_API_KEY
# A slot's hard cap: Claude records an absolute refresh-token expiry (ms epoch);
# the slots lib pulls it with this sed pattern to warn before a slot goes cold.
ADAPTER_EXP_PATTERN='.*"refreshTokenExpiresAt":\([0-9][0-9]*\).*'

# The REAL Claude Code binary: the npm-global / local-install spots first,
# then PATH in the user's order. $CLAUDE_BIN overrides (odd install / test).
#
# Both the override check and the skip-the-shim rule live in
# libexec/adapter.sh, so every adapter gets them identically.
adapter_realbin() {
  realbin_from claude "$HOME/.npm-global/bin/claude" \
    /usr/local/bin/claude
}

# Launch-time environment. Claude via apt lags and nags about updates -- silence
# it. (ANTHROPIC_API_KEY is scrubbed via ADAPTER_UNSET_ENV, honoured by both the
# exec path and `valet-key login`.)
adapter_preexec() {
  DISABLE_AUTOUPDATER=1; export DISABLE_AUTOUPDATER
}
